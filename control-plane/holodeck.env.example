# Holodeck control-plane config — copy to `holodeck.env` (gitignored) and edit.
# Auto-loaded at startup (or point HOLODECK_ENV_FILE=/path/to/file at it).
# A real environment variable always overrides a value set here.

# --- service ---
# HOLODECK_HOST=127.0.0.1                # 0.0.0.0 to accept connections from
                                          # outside this machine (e.g. a Docker
                                          # container reaching in via
                                          # host.docker.internal — needed for
                                          # the local Omnigent smoke test)
# HOLODECK_PORT=8099
# HOLODECK_TOKEN=                        # shared admin token for the REST API
                                          # — MUST match Omnigent's own
                                          # HOLODECK_TOKEN (omnigent-deploy/omnigent/.env)
# HOLODECK_PROVIDER=compose              # compose | fake | eks
                                          # fake = in-memory, no Docker/golden
                                          # build needed — for smoke-testing the
                                          # Omnigent<->control-plane wiring only

# --- run schedules ---
# HOLODECK_TTL_S=1800                    # lease TTL (seconds)
# HOLODECK_REAPER_S=30                   # TTL reaper cadence
# HOLODECK_CONSOLE_POLL_S=5              # console/bridge poll cadence

# --- console / agent driver ---
# HOLODECK_CONSOLE_DRIVER=omnigent       # direct | omnigent
# HOLODECK_DEFAULT_APP=compliance

# --- console preview link ---
# Static preview URL shown for every workspace (empty = per-lease 127.0.0.1:<port>).
# HOLODECK_PREVIEW_URL=https://admin.omnigent.junipersquare.us/canopy/login

# --- environments shown in the console ---
# This holodeck-gcp copy only kept the control-tower manifest (see
# ../../../docs/ for why compliance-ui/compliance were removed) — set this to
# whatever manifests actually exist under ../manifests/. full-stack-application
# is what's actually been built/tested here (control-tower is a real manifest
# but was never actually run on this holodeck-gcp copy).
HOLODECK_APPS=full-stack-application
# HOLODECK_SSH_HOST=holo-ec2             # author tunnel target (dev-testing preview)
# HOLODECK_OMNIGENT_URL=https://omnigent-test.jsq.tools   # Omnigent server (real driver)
# HOLODECK_OMNIGENT_TOKEN=<bearer from `omnigent login`>  # server auth
# HOLODECK_OMNIGENT_AGENT=<registered agent id>   # defaults to Polly (see config.py)
# HOLODECK_OMNIGENT_FAKE=0                # 1 = in-memory fake (no server needed)

# --- Jira bridge (real integration) ---
HOLODECK_JIRA=1
HOLODECK_JIRA_FAKE=0
HOLODECK_JIRA_BASE_URL=https://<your-org>.atlassian.net
HOLODECK_JIRA_EMAIL=you@junipersquare.com
HOLODECK_JIRA_TOKEN=<atlassian-api-token>
HOLODECK_JIRA_BOT=<bot-accountId>        # comments by this account are ignored (loop guard)
# HOLODECK_JIRA_PREFIX=/holodeck
# HOLODECK_JIRA_LABEL=holodeck           # the trigger label
# HOLODECK_JIRA_HALT_LABEL=holodeck:halt # swapped in when the agent stops and needs a human

# --- Jira inbound polling (no webhook; the EC2 control plane reaches out to Jira) ---
HOLODECK_JIRA_PROJECT=<PROJECT-KEY>      # project to scan for labelled tickets (empty = polling off)
# HOLODECK_JIRA_POLL_S=60                # how often to poll for triggers + replies
# HOLODECK_JIRA_WEBHOOK_SECRET=<secret>  # only for the push-webhook path (not needed for polling)

# --- agent / MCP + tool tokens (forwarded to the workspace agent) ---
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=
